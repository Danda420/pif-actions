cleanup() {
    rm -f PIXEL_VERSIONS_HTML PIXEL_LATEST_HTML PIXEL_FI_HTML PIXEL_OTA_HTML \
          PIXEL_FLASH_HTML PIXEL_STATION_JSON PIXEL_CANARY_JSON PIXEL_SECBULL_HTML \
          tmp_keybox PIF-tmp.apk PIF.apk.idsig
    rm -rf pif-apk
}
trap cleanup EXIT

echo "Crawling Android Developers for latest Pixel Beta list..."
wget -q -O PIXEL_VERSIONS_HTML --no-check-certificate "https://developer.android.com/about/versions"
LATEST_BETA=$(grep -B4 -A2 'data-icon="preview' PIXEL_VERSIONS_HTML | grep -o 'href="/about/versions/.*[0-9]"' | cut -d\" -f2)
[ -z "$LATEST_BETA" ] && LATEST_BETA=$(grep -oE 'href="/about/versions/[0-9]{2}"' PIXEL_VERSIONS_HTML | cut -d\" -f2 | sort -ru | head -n1)
wget -q -O PIXEL_LATEST_HTML --no-check-certificate "https://developer.android.com$LATEST_BETA"

FI_URL="https://developer.android.com$(grep -o 'href=".*download.*"' PIXEL_LATEST_HTML | grep -v 'ota' | cut -d\" -f2 | sort -ru | head -n1)"
OTA_URL="https://developer.android.com$(grep -o 'href=".*download-ota.*"' PIXEL_LATEST_HTML | cut -d\" -f2 | sort -ru | head -n1)"

wget -q -O PIXEL_FI_HTML --no-check-certificate "$FI_URL"
wget -q -O PIXEL_OTA_HTML --no-check-certificate "$OTA_URL"

SRC_HTML="PIXEL_FI_HTML"
if [ "$(grep 'tr id=' PIXEL_FI_HTML | sed 's;.*<tr id="\(.*\)">.*;\1;' | wc -w)" -lt "$(grep 'tr id=' PIXEL_OTA_HTML | sed 's;.*<tr id="\(.*\)">.*;\1;' | wc -w)" ]; then
    SRC_HTML="PIXEL_OTA_HTML"
fi

RAW_MODEL_LIST="$(grep -A1 'tr id=' "$SRC_HTML" | grep 'td' | sed 's;.*<td>\(.*\)</td>.*;\1;')"
RAW_PRODUCT_LIST="$(grep 'tr id=' "$SRC_HTML" | sed 's;.*<tr id="\(.*\)">.*;\1_beta;')"

TARGET_DEVICE=$(echo "$TARGET_DEVICE" | tr '[:upper:]' '[:lower:]' | sed 's/_beta$//')
MODEL=""
PRODUCT=""
DEVICE=""

while IFS= read -r curr_model <&3 && IFS= read -r curr_product <&4; do
    curr_dev="${curr_product%_beta}"
    if [[ "$curr_dev" == "$TARGET_DEVICE" ]]; then
        MODEL="$curr_model"
        PRODUCT="$curr_product"
        DEVICE="$curr_dev"
        break
    fi
done 3<<<"$RAW_MODEL_LIST" 4<<<"$RAW_PRODUCT_LIST"

if [[ -z "$DEVICE" ]]; then
    echo "Error: Device '$TARGET_DEVICE' not found on Android Developers page."
    exit 1
fi

case $DEVICE in
  bluejay) FIRST_API_LEVEL=32;;
  panther|cheetah|lynx|felix|tangorpro) FIRST_API_LEVEL=33;;
  shiba|husky|akita|tokay|caiman|komodo|comet) FIRST_API_LEVEL=34;;
  tegu|stallion) FIRST_API_LEVEL=35;;
  frankel|blazer|mustang|rango) FIRST_API_LEVEL=36;;
  cubs|grizzly|kodiak|yogi) FIRST_API_LEVEL=37;;
  *) FIRST_API_LEVEL=32;;
esac

echo "Selected: $MODEL ($PRODUCT) - SDK: $FIRST_API_LEVEL"
echo "Crawling Android Flash Tool for latest build info..."
wget -q -O PIXEL_FLASH_HTML --no-check-certificate "https://flash.android.com/"
API_KEY=$(grep -o '<body data-client-config=.*' PIXEL_FLASH_HTML | cut -d\; -f2 | cut -d\& -f1)

wget -q -O PIXEL_STATION_JSON --header "Referer: https://flash.android.com" --no-check-certificate "https://content-flashstation-pa.googleapis.com/v1/builds?product=$PRODUCT&key=$API_KEY"

tac PIXEL_STATION_JSON | grep -m1 -A13 '"canary": true' > PIXEL_CANARY_JSON
ID="$(grep 'releaseCandidateName' PIXEL_CANARY_JSON | cut -d\" -f4)"
INCREMENTAL="$(grep 'buildId' PIXEL_CANARY_JSON | cut -d\" -f4)"
RELEASE_NAME="$(grep 'releaseTrackVersionName' PIXEL_CANARY_JSON | cut -d\" -f4)"

[ -z "$ID" ] && echo "Error: Failed to extract build info" && exit 1

CANARY_ID_SHORT="$(grep '"id"' PIXEL_CANARY_JSON | sed -e 's;.*canary-\(.*\)".*;\1;' -e 's;^\(.\{4\}\);\1-;')"
wget -q -O PIXEL_SECBULL_HTML --no-check-certificate "https://source.android.com/docs/security/bulletin/pixel"
SECURITY_PATCH="$(grep "<td>$CANARY_ID_SHORT" PIXEL_SECBULL_HTML | sed 's;.*<td>\(.*\)</td>;\1;' | head -n1)"
[ -z "$SECURITY_PATCH" ] && SECURITY_PATCH="${CANARY_ID_SHORT}-05"

BRAND="google"
MANUFACTURER="Google"
TYPE="user"
TAGS="release-keys"
RELEASE=$(echo "$RELEASE_NAME" | grep -oE '[0-9]+')
FINGERPRINT="google/$PRODUCT/$DEVICE:CANARY/$ID/$INCREMENTAL:user/release-keys"

########## KEYBOX & PIF APK ##########

if [[ ! -f PIF.apk ]]; then
    echo "Error: Base PIF.apk not found in working directory."
    exit 1
fi

apktool d PIF.apk -o pif-apk --quiet
rm -f PIF.apk

CUSTOM_KEYBOX=false
curl -Ls http://evoker.qzz.io/key | base64 -d > tmp_keybox 2>/dev/null || true

if [[ -s tmp_keybox ]] && grep -q -- "-----BEGIN" tmp_keybox; then
    KeyboxSize=$(grep -o -- "-----BEGIN" tmp_keybox | wc -l)

    if grep -qi "ecdsa" tmp_keybox && ! grep -qi "rsa" tmp_keybox; then
        KEYBOX_TYPE="ec"
    elif ! grep -qi "ecdsa" tmp_keybox && grep -qi "rsa" tmp_keybox; then
        KEYBOX_TYPE="rsa"
    else
        KEYBOX_TYPE="ec_rsa"
    fi

    if [[ "$KEYBOX_TYPE" == "ec" || "$KEYBOX_TYPE" == "ec_rsa" ]]; then
        EC_PRIV_KEY=$(xmllint --xpath "//Key[@algorithm='ecdsa']/PrivateKey/text()" tmp_keybox 2>/dev/null | sed -e 's/^[ \t]*//' -e '/^$/d')
        EC_CERT_1=$(xmllint --xpath "(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[1]/text()" tmp_keybox 2>/dev/null | sed -e 's/^[ \t]*//' -e '/^$/d')
        EC_CERT_2=$(xmllint --xpath "(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[2]/text()" tmp_keybox 2>/dev/null | sed -e 's/^[ \t]*//' -e '/^$/d')
        EC_CERT_3=$(xmllint --xpath "(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[3]/text()" tmp_keybox 2>/dev/null | sed -e 's/^[ \t]*//' -e '/^$/d')
        EC_CERT_4=$(xmllint --xpath "(//Key[@algorithm='ecdsa']/CertificateChain/Certificate)[4]/text()" tmp_keybox 2>/dev/null | sed -e 's/^[ \t]*//' -e '/^$/d')
    fi

    if [[ "$KEYBOX_TYPE" == "rsa" || "$KEYBOX_TYPE" == "ec_rsa" ]]; then
        RSA_PRIV_KEY=$(xmllint --xpath "//Key[@algorithm='rsa']/PrivateKey/text()" tmp_keybox 2>/dev/null | sed -e 's/^[ \t]*//' -e '/^$/d')
        RSA_CERT_1=$(xmllint --xpath "(//Key[@algorithm='rsa']/CertificateChain/Certificate)[1]/text()" tmp_keybox 2>/dev/null | sed -e 's/^[ \t]*//' -e '/^$/d')
        RSA_CERT_2=$(xmllint --xpath "(//Key[@algorithm='rsa']/CertificateChain/Certificate)[2]/text()" tmp_keybox 2>/dev/null | sed -e 's/^[ \t]*//' -e '/^$/d')
        RSA_CERT_3=$(xmllint --xpath "(//Key[@algorithm='rsa']/CertificateChain/Certificate)[3]/text()" tmp_keybox 2>/dev/null | sed -e 's/^[ \t]*//' -e '/^$/d')
        RSA_CERT_4=$(xmllint --xpath "(//Key[@algorithm='rsa']/CertificateChain/Certificate)[4]/text()" tmp_keybox 2>/dev/null | sed -e 's/^[ \t]*//' -e '/^$/d')
    fi

    if [[ -n "$EC_PRIV_KEY" || -n "$RSA_PRIV_KEY" ]]; then
        CUSTOM_KEYBOX=true
    else
        echo "Warning: Keybox XML parsed 0 keys, falling back to AOSP keys..."
        KeyboxSize=6
        KEYBOX_TYPE="ec_rsa"
        aosp_cert
    fi
else
    echo "Warning: Remote keybox unavailable, falling back to AOSP keys..."
    KeyboxSize=6
    KEYBOX_TYPE="ec_rsa"
    aosp_cert
fi

echo "Keybox Size: ${KeyboxSize} | Type: ${KEYBOX_TYPE}"

versionCode=$(date +"%Y%m%d")
versionName=$(date +"%Y.%m.%d")

cat <<EOF > pif-apk/AndroidManifest.xml
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="$versionCode"
    android:versionName="$versionName"
    android:compileSdkVersion="30"
    android:compileSdkVersionCodename="1.0"
    package="com.oemports10t.pif"
    platformBuildVersionCode="30"
    platformBuildVersionName="1.0">
    <uses-sdk
        android:minSdkVersion="30"
        android:targetSdkVersion="34" />
    <application
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:usesNonSdkApi="true" />
</manifest>
EOF

cat <<EOF > pif-apk/res/values/arrays.xml
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="device_props">
        <item>$MANUFACTURER</item>
        <item>$MODEL</item>
        <item>$FINGERPRINT</item>
        <item>$BRAND</item>
        <item>$PRODUCT</item>
        <item>$DEVICE</item>
        <item>$SECURITY_PATCH</item>
        <item>$FIRST_API_LEVEL</item>
    </string-array>
    <string-array name="vendor_props">
        <item>null</item>
    </string-array>
    <string-array name="keybox">
EOF

if [[ "$KEYBOX_TYPE" == "ec" || "$KEYBOX_TYPE" == "ec_rsa" ]]; then
    [[ -n "$EC_PRIV_KEY" ]] && echo "        <item>\"$EC_PRIV_KEY\"</item>" >> pif-apk/res/values/arrays.xml
    [[ -n "$EC_CERT_1" ]] && echo "        <item>\"$EC_CERT_1\"</item>" >> pif-apk/res/values/arrays.xml
    [[ -n "$EC_CERT_2" ]] && echo "        <item>\"$EC_CERT_2\"</item>" >> pif-apk/res/values/arrays.xml
    [[ -n "$EC_CERT_3" ]] && echo "        <item>\"$EC_CERT_3\"</item>" >> pif-apk/res/values/arrays.xml
    [[ -n "$EC_CERT_4" ]] && echo "        <item>\"$EC_CERT_4\"</item>" >> pif-apk/res/values/arrays.xml
fi
if [[ "$KEYBOX_TYPE" == "rsa" || "$KEYBOX_TYPE" == "ec_rsa" ]]; then
    [[ -n "$RSA_PRIV_KEY" ]] && echo "        <item>\"$RSA_PRIV_KEY\"</item>" >> pif-apk/res/values/arrays.xml
    [[ -n "$RSA_CERT_1" ]] && echo "        <item>\"$RSA_CERT_1\"</item>" >> pif-apk/res/values/arrays.xml
    [[ -n "$RSA_CERT_2" ]] && echo "        <item>\"$RSA_CERT_2\"</item>" >> pif-apk/res/values/arrays.xml
    [[ -n "$RSA_CERT_3" ]] && echo "        <item>\"$RSA_CERT_3\"</item>" >> pif-apk/res/values/arrays.xml
    [[ -n "$RSA_CERT_4" ]] && echo "        <item>\"$RSA_CERT_4\"</item>" >> pif-apk/res/values/arrays.xml
fi

cat <<EOF >> pif-apk/res/values/arrays.xml
    </string-array>
</resources>
EOF

cat <<EOF > pif-apk/res/values/strings.xml
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="security_patch">$SECURITY_PATCH</string>
    <string name="keybox_type">$KEYBOX_TYPE</string>
</resources>
EOF

cat <<EOF > pif-apk/res/values/public.xml
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <public type="array" name="device_props" />
    <public type="array" name="keybox" />
    <public type="array" name="vendor_props" />
    <public type="string" name="security_patch" />
    <public type="string" name="keybox_type" />
</resources>
EOF

apktool b -o PIF-tmp.apk --use-aapt2 --no-crunch pif-apk --quiet
zipalign -v 4 PIF-tmp.apk PIF.apk > /dev/null
apksigner sign --key "$PWD/signature/danda.pk8" --cert "$PWD/signature/danda.x509.pem" PIF.apk > /dev/null

if [[ "$CUSTOM_KEYBOX" == "true" ]]; then
    keyboxtype="CUSTOM (${KeyboxSize})"
else
    keyboxtype="AOSP (6)"
fi

cat <<EOF > info.txt
VERSION           : $versionName
--------------------------------
MANUFACTURER      : $MANUFACTURER
MODEL 	          : $MODEL
FINGERPRINT       : $FINGERPRINT
BRAND             : $BRAND
PRODUCT           : $PRODUCT
DEVICE            : $DEVICE
RELEASE           : $RELEASE
ID                : $ID
INCREMENTAL       : $INCREMENTAL
TYPE              : $TYPE
TAGS              : $TAGS
SECURITY PATCH    : $SECURITY_PATCH
FIRST API LEVEL   : $FIRST_API_LEVEL
SPOOF VENDING SDK : $SPOOF_VENDING_SDK
KEYBOX            : $keyboxtype
EOF

cat <<EOF > pif.json
{
  "MANUFACTURER": "$MANUFACTURER",
  "BRAND": "$BRAND",
  "DEVICE": "$DEVICE",
  "PRODUCT": "$PRODUCT",
